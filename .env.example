# Optional. Leave empty until a real GA4 web data stream is available.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Repair estimate assistant (/[locale]/auto-repair). The chat section renders
# only when NEXT_PUBLIC_REPAIR_CHAT_ENABLED=true at build time, and the
# /api/repair-chat endpoint answers only when all three secrets are set.
NEXT_PUBLIC_REPAIR_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5; set claude-opus-5-5 for stronger reasoning.
REPAIR_CHAT_MODEL=
WORLDPAC_USERNAME=
WORLDPAC_PASSWORD=

# Follow-up email to the shop when a visitor leaves or goes quiet (10 min).
# Gmail: use an app password (myaccount.google.com → Security → App passwords).
# Without SMTP_USER / SMTP_PASS the email is written to the server log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=speedxrentalcar@gmail.com
LEAD_EMAIL_FROM=

# Optional: also POST each lead event (JSON) to a webhook (Zapier, Make, Slack…).
REPAIR_LEAD_WEBHOOK_URL=
